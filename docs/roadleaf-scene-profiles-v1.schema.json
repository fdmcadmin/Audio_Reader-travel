{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal collection voice metadata for Roadleaf",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "profileSetId",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "roadleaf-scene-profiles"
    },
    "version": {
      "const": 1
    },
    "profileSetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "keys"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "category": {
            "const": "Characters"
          },
          "enabled": {
            "type": "boolean"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "voice": {
            "type": "string",
            "maxLength": 160
          },
          "voiceService": {
            "type": "string",
            "maxLength": 160
          },
          "ttsProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "model", "voice", "sid"],
            "properties": {
              "service": { "const": "sherpa-onnx" },
              "model": { "enum": ["kokoro-multi-lang-v1_0", "kokoro-int8-multi-lang-v1_0"] },
              "voice": { "type": "string", "minLength": 1, "maxLength": 160 },
              "sid": { "type": "integer", "minimum": 0, "maximum": 27 }
            }
          },
          "pronoun": {
            "enum": [
              "AUTO",
              "HE",
              "SHE",
              "THEY"
            ]
          },
          "delivery": {
            "enum": [
              "FOLLOW_STORY",
              "NATURAL",
              "LOWER"
            ]
          }
        }
      }
    },
    "enginePackage": {
      "type": "string",
      "maxLength": 160
    },
    "voiceService": {
      "type": "string",
      "maxLength": 160
    },
    "mainVoice": {
      "type": "string",
      "maxLength": 160
    },
    "narratorVoice": {
      "type": "string",
      "maxLength": 160
    },
    "mainCharacter": {
      "type": "string",
      "maxLength": 240
    },
    "mainPronoun": {
      "enum": [
        "AUTO",
        "HE",
        "SHE",
        "THEY"
      ]
    }
  }
}
